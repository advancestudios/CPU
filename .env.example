# Copia este archivo como ".env" y rellena tus datos reales.
# El archivo ".env" NUNCA debe subirse a GitHub (ya está en .gitignore).

DISCORD_TOKEN=tu_token_aqui
CLIENT_ID=tu_client_id_aqui

# Opcional: mientras estás en beta, pon el ID de tu servidor de pruebas
# para que los comandos se actualicen al instante (sin esto, tardan hasta 1h).
GUILD_ID=
